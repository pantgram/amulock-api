    "/api/v1/venue/events/{event_id}/claims": {
      "get": {
        "tags": [
          "Venue"
        ],
        "summary": "List Event Claims",
        "description": "The event's claims, oldest first. Errors: EventNotFoundError.",
        "operationId": "list_event_claims_api_v1_venue_events__event_id__claims_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "event_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Event Id"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "pending",
                    "stored",
                    "collected",
                    "unclaimed",
                    "cancelled"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ClaimResponse"
                  },
                  "title": "Response List Event Claims Api V1 Venue Events  Event Id  Claims Get"
