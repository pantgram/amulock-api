PORT=5000
# asyncpg URL. libpq-only params like ?sslmode=require are stripped for the app automatically.
DATABASE_URL="postgresql+asyncpg://amulock:amulock@localhost:5432/amulock"
NODE_ENV="development"
LOG_FILE="/tmp/amulock_api.log"

# Where the Guest app is served (used to build the URLs encoded in QR codes)
GUEST_BASE_URL="http://localhost:5173"
# Browser origins allowed by CORS: Guest app, Venue app (comma-separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# Server-only Clerk secret key (sk_test_... / sk_live_...). Required for token verification (JWKS fallback).
CLERK_SECRET_KEY="sk_test_YOURSECRETKEY"
# Optional PEM public key (Clerk dashboard: API Keys > Public key > PEM) for networkless verification.
# Leave empty to fall back to JWKS (auto rotation, ~5 min cache).
CLERK_JWT_KEY=""
# Comma-separated list of acceptable `azp` values: the Venue app's origin(s).
CLERK_AUTHORIZED_PARTIES="http://localhost:5174"
